#!/usr/bin/env bash

set -euo pipefail

self_name=${0##*/}

lib_dir=${DICEWARE_LIB_DIR:-./lib}

usage="Simulate a series of six-sided dice rolls.

Usage:
    $self_name [OPTIONS] COUNT

Options:
    -h, --help       show this help message and exit
    -v, --version    show the program's version number and exit

    -5, --long     simulate five rolls per word (the default)
    -4, --short    simulate four rolls per word

Arguments:
    COUNT     simulate rolls for COUNT words

See also:
    dicegen(1)
"

unset list
roll_count=5

while (($# > 0)); do
    arg=$1
    if [[ $arg != -* ]]; then
        break
    fi
    shift
    if [[ $arg == -- ]]; then
        break
    elif [[ $arg == -h || $arg == --help ]]; then
        printf "%s\n" "$usage"
        exit
    elif [[ $arg == -v || $arg == --version ]]; then
        cat "$lib_dir"/version
        exit
    elif [[ $arg == -4 || $arg == --short ]]; then
        roll_count=4
    elif [[ $arg == -5 || $arg == --long ]]; then
        roll_count=5
    else
        printf "%s: invalid option: %q\n" "$self_name" "$arg" >&2
        exit 64
    fi
done

word_count=${1:?missing word count}

for ((i = 0; i < word_count; i++)); do
    shuf --random-source=/dev/urandom -i 1-6 -n "$roll_count" | paste -s -d ''
done
