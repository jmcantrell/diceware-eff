#!/usr/bin/env bash

set -euo pipefail

self_name=${0##*/}

lib_dir=${DICEWARE_LIB_DIR:-/usr/local/lib/$self_name}
data_dir=${DICEWARE_DATA_DIR:-/usr/local/share/$self_name}

usage="Generate a passphrase from dice rolls.

Usage:
    $self_name [OPTIONS] [FILE]

Options:
    -h, --help       show this help message and exit
    -v, --version    show the program's version number and exit

    -l, --list    print the word list instead of generating a passphrase

    -5    use the word list requiring five rolls per word (the default)
    -4    use the word list requiring four rolls per word

Arguments:
    FILE    read dice rolls from FILE (default: stdin)

See also:
    dicegen(1)
"

unset list
roll_count=5

while (($# > 0)); do
    arg=$1
    if [[ $arg != -* ]]; then
        break
    fi
    shift
    if [[ $arg == -- ]]; then
        break
    elif [[ $arg == -h || $arg == --help ]]; then
        printf "%s\n" "$usage"
        exit
    elif [[ $arg == -v || $arg == --version ]]; then
        printf "%s\n" "$(<"$lib_dir"/version)"
        exit
    elif [[ $arg == -4 ]]; then
        roll_count=4
    elif [[ $arg == -5 ]]; then
        roll_count=5
    elif [[ $arg == -l || $arg == --list ]]; then
        list=true
    else
        printf "%s: invalid option: %q\n" "$self_name" "$arg" >&2
        exit 64
    fi
done

input_file=${1:-/dev/stdin}

data_file=$data_dir/wordlists/roll$roll_count

if [[ -v list ]]; then
    cat "$data_file"
    exit
fi

declare -A cache=()

while read -r digits word; do
    cache[$digits]=$word
done <"$data_file"

phrase=
roll_num=1

while read -r roll; do
    if [[ ! $roll =~ ^[1-6]+$ ]]; then
        printf "%s: roll %d has an invalid digit (i.e. not between 1 and 6)\n" "$0" "$roll_num" >&2
        exit 64
    fi

    if ((${#roll} != roll_count)); then
        printf "%s: roll %d must be %d digits, got %d\n" "$self_name" "$roll_num" "$roll_count" "${#roll}" >&2
        exit 64
    fi

    phrase+="${cache[$roll]} "
    roll_num=$((roll_num + 1))

done <"$input_file"

if [[ -n $phrase ]]; then
    printf "%s\n" "${phrase:0:-1}"
fi
