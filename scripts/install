#!/usr/bin/env bash

set -euo pipefail

dir=${DESTDIR:-}${PREFIX:-/usr/local}

install -p -m755 -D -t "$dir"/bin ./bin/*
install -p -m644 -D -t "$dir"/lib/diceware ./lib/*
install -p -m644 -D -t "$dir"/share/diceware/wordlists ./share/wordlists/*
install -p -m644 -D -t "$dir"/share/man/man1 ./man/*.1
install -p -m644 -D -t "$dir"/share/doc/diceware ./README.md
install -p -m644 -D -t "$dir"/share/licenses/diceware ./LICENSE
