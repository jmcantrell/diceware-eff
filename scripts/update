#!/usr/bin/env bash

set -euo pipefail

self_name=${0##*/}

temp_dir=$(mktemp -td -- "$self_name.$$".XXXXXXXXXX)
trap 'rm -rf -- "$temp_dir"' EXIT

for roll_count in 4 5; do
    config_file=./config/wordlists/roll$roll_count

    url=$(<"$config_file")
    wordlist_file=./share/wordlists/roll$roll_count

    printf "Downloading: %s\n" "$url"

    temp_file=$temp_dir/${wordlist_file##*/}

    mkdir -p -- "${wordlist_file%/*}"
    if [[ ! -f $wordlist_file ]]; then
        touch -t 190001010000.00 -- "$wordlist_file"
    fi
    curl -o "$temp_file" -z "$wordlist_file" "$url"

    if [[ ! -s $temp_file ]]; then
        continue
    fi

    mv -- "$temp_file" "$wordlist_file".new

    printf "Checking: %q\n" "$wordlist_file".new
    ./scripts/ckwordlist "$roll_count" "$wordlist_file".new

    mv -v -- "$wordlist_file"{.new,}
done
